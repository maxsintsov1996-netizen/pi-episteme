{
  "name": "pi-episteme",
  "version": "0.3.0",
  "description": "Advanced context compaction for pi-coding-agent: a phased plan pipeline (research → plan → steps) with a byte-stable prompt prefix and KV-cache reuse for local LLMs.",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "pi", "pi-coding-agent", "context", "compaction", "plan", "kv-cache", "llm"],
  "homepage": "https://github.com/maxsintsov1996-netizen/pi-episteme#readme",
  "bugs": {
    "url": "https://github.com/maxsintsov1996-netizen/pi-episteme/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxsintsov1996-netizen/pi-episteme.git"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/maxsintsov1996-netizen/pi-episteme/master/img/pi-episteme.png"
  },
  "files": [
    "index.ts",
    "episteme.ts",
    "prompts.ts",
    "compaction.ts",
    "config.ts",
    "check.cjs",
    "local-check.cjs",
    "README.md",
    "README.ru.md",
    "SPEC.md",
    "img/pi-episteme.png"
  ],
  "scripts": {
    "test": "node check.cjs",
    "test:local": "node local-check.cjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.85.0",
    "@earendil-works/pi-coding-agent": ">=0.85.0",
    "@earendil-works/pi-tui": ">=0.85.0",
    "typebox": ">=1.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
